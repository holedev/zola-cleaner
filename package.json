{
  "name": "zola-cleaner",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app to clean up media that Zalo PC downloads to Windows machines",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @zola-cleaner/desktop tauri dev",
    "build": "pnpm --filter @zola-cleaner/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
