{
  "name": "zalo-cleaner",
  "private": true,
  "version": "0.1.0",
  "description": "Local web app to analyze and clean up Zalo PC media storage",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "scan": "tsx packages/core/src/cli.ts scan",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
