{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zola Cleaner",
  "version": "0.1.0",
  "identifier": "io.github.zola-cleaner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zola Cleaner",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: thumb: http://thumb.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Zola Cleaner",
    "shortDescription": "Dọn ảnh, video, tài liệu Zalo PC tự tải về máy",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
