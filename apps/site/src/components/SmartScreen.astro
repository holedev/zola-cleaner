---
// Hình minh hoạ hộp thoại SmartScreen của Windows, vẽ bằng HTML/CSS. Thay bằng ảnh chụp thật khi có.
import type { Copy } from "../lib/i18n";

interface Props {
  copy: Copy;
}
const s = Astro.props.copy.install.smartscreen;
---

<div class="grid gap-3 sm:grid-cols-2" aria-hidden="true">
  <figure class="overflow-hidden rounded-lg bg-[#0063b1] p-5 text-white shadow-md">
    <p class="text-xl font-light">Windows protected your PC</p>
    <p class="mt-3 text-xs leading-relaxed text-white/85">
      Microsoft Defender SmartScreen prevented an unrecognized app from starting. Running this app might put your PC at risk.
    </p>
    <p class="mt-2 text-xs">
      <span class="relative inline-block font-semibold underline">
        {s.more}
        <span class="absolute -inset-x-2 -inset-y-1 rounded-full border-2 border-[#ffd34d]"></span>
      </span>
    </p>
    <div class="mt-8 flex justify-end">
      <span class="rounded-sm border border-white/70 px-4 py-1 text-xs">{s.dont}</span>
    </div>
    <figcaption class="sr-only">1</figcaption>
  </figure>
  <figure class="overflow-hidden rounded-lg bg-[#0063b1] p-5 text-white shadow-md">
    <p class="text-xl font-light">Windows protected your PC</p>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs text-white/85">
      <dt>{s.app}</dt>
      <dd>Zola.Cleaner_x.y.z_x64-setup.exe</dd>
      <dt>{s.publisher}</dt>
      <dd>{s.unknown}</dd>
    </dl>
    <div class="mt-8 flex justify-end gap-2">
      <span class="relative rounded-sm border border-white/70 px-4 py-1 text-xs">
        {s.run}
        <span class="absolute -inset-1.5 rounded-md border-2 border-[#ffd34d]"></span>
      </span>
      <span class="rounded-sm border border-white/70 px-4 py-1 text-xs">{s.dont}</span>
    </div>
    <figcaption class="sr-only">2</figcaption>
  </figure>
</div>
